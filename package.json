{
  "name": "ils-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run knowledge",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "knowledge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-knowledge.mjs",
    "test": "node --test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed",
    "db:status": "node scripts/db.mjs status"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "^15.3.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.169.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.169.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
