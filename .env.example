# ── Database ─────────────────────────────────────────────────────────
# Local Postgres:  npm run db:up && npm run db:migrate && npm run db:seed
# Leave empty and the site still runs: news falls back to the published JSON
# file and then to the seed content, and sign-in falls back to the single
# administrator below.
DATABASE_URL=postgres://ils:ils_local_dev@127.0.0.1:5432/ils

# Only used by `npm run db:seed`, to create the very first account.
# ADMIN_SEED_PASSWORD=

# Copy to .env.local and fill in. .env.local is git-ignored by Next.js.

# SAM.gov Get Opportunities API — powers the "Open solicitations" panel on /intel.
# Register a free key at https://api.sam.gov/ (needs a sam.gov login).
# Without this, the panel falls back to keyless Grants.gov data.
SAM_API_KEY=

# Optional: override the SAM.gov base URL. Used to exercise the integration
# against a local mock; leave unset in normal use.
# SAM_API_BASE=http://127.0.0.1:4010

# ── Admin sign-in ────────────────────────────────────────────────────
# Required. Without BOTH a secret and a password the admin fails closed:
# every /admin route redirects to the login page and nobody gets in.
#
# Generate the secret with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Username (defaults to "admin" when unset)
ADMIN_USERNAME=admin

# Prefer the hash so a plaintext password never sits in an env file:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR-PASSWORD').digest('hex'))"
ADMIN_PASSWORD_SHA256=

# Plaintext fallback for local use only. Ignored when the hash is set.
# ADMIN_PASSWORD=

# ── Contact form → email ─────────────────────────────────────────────
# Where website inquiries are delivered. Defaults to inquiries@intllogic.com.
INQUIRY_TO=inquiries@intllogic.com

# Envelope sender. Must be an address the SMTP account is allowed to send as,
# or the mail will be rejected or land in junk. Defaults to SMTP_USER.
# INQUIRY_FROM=no-reply@intllogic.com

# SMTP credentials. Without all three the form fails closed: it tells the
# visitor to email INQUIRY_TO directly rather than pretending to have sent.
# For Microsoft 365: smtp.office365.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set true only for implicit TLS on port 465; 587 upgrades via STARTTLS.
# SMTP_SECURE=false

# ── Analytics ────────────────────────────────────────────────────────
# These are now managed from the admin dashboard: Settings → Analytics.
# The values below act only as a fallback for a deployment that wants to pin
# them from infrastructure; anything saved in the admin takes precedence.
# Google Tag Manager container. Leave empty and no tag loads at all —
# nothing is sent to Google in development or in the proof of concept.
# Public site only; the admin dashboard is deliberately never tagged.
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4. Two ways to run GA4 — pick ONE:
#
#   1. PREFERRED, and no code: leave this empty and add a GA4 Configuration
#      tag inside the GTM container above. GTM is the tag manager; GA4 is a
#      tag inside it, and marketing can change it without a deploy.
#   2. Direct: set the measurement id here and leave NEXT_PUBLIC_GTM_ID empty.
#
# Setting both counts every visit twice, so if GTM is configured this is
# ignored and the build log says so.
NEXT_PUBLIC_GA_ID=
